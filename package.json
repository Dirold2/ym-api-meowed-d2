{
  "name": "yamd2",
  "version": "1.5.1",
  "description": "A Node.js wrapper for the Yandex.Music API (Unofficial) http://music.yandex.ru",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Anton Petrov",
  "contributors": [
    "Anton Petrov (https://itsmepetrov.com)",
    "Evgeny Kontsevoy (https://github.com/kontsevoye)",
    "Donnevtis (https://github.com/Donnevtis)",
    "KotIsOff (https://github.com/kotisoff)",
    "Dirold2 (https://github.com/dirold2)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dirold2/yamd2.git"
  },
  "keywords": [
    "yandex",
    "music",
    "api",
    "wrapper",
    "yandex.music"
  ],
  "dependencies": {
    "@hyperttp/transport-bun": "^0.3.2",
    "@hyperttp/transport-undici": "^0.3.2",
    "@hyperttp/types": "^0.3.0",
    "chalk": "^6.0.0",
    "crypto": "^1.0.1",
    "hyperttp": "^0.5.4"
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.3",
    "@types/node": "^26.3.0",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsc && esbuild 'dist/**/*.js' --outdir=dist --allow-overwrite --minify --sourcemap && d-build",
    "dist": "d-dist",
    "deploy": "npm run build && npm run dist",
    "pub": "d-publish",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "smoke:xml": "tsx example/smoke-xml-parse.ts",
    "smoke:token": "dotenv -e .env -- tsx example/token.ts",
    "smoke:artist": "dotenv -e .env -- tsx example/artist.ts",
    "smoke:album": "dotenv -e .env -- tsx example/album.ts",
    "smoke:clip": "dotenv -e .env -- tsx example/clip.ts",
    "smoke:concert": "dotenv -e .env -- tsx example/concert.ts",
    "smoke:credit": "dotenv -e .env -- tsx example/credit.ts",
    "smoke:disclaimer": "dotenv -e .env -- tsx example/disclaimer.ts",
    "smoke:feed": "dotenv -e .env -- tsx example/feed.ts",
    "smoke:genres": "dotenv -e .env -- tsx example/genres.ts",
    "smoke:label": "dotenv -e .env -- tsx example/label.ts",
    "smoke:metatag": "dotenv -e .env -- tsx example/metatag.ts",
    "smoke:music-history": "dotenv -e .env -- tsx example/music-history.ts",
    "smoke:pin": "dotenv -e .env -- tsx example/pin.ts",
    "smoke:playlist": "dotenv -e .env -- tsx example/playlist.ts",
    "smoke:playlist-share": "dotenv -e .env -- tsx example/playlist-share.ts",
    "smoke:presave": "dotenv -e .env -- tsx example/presave.ts",
    "smoke:track": "dotenv -e .env -- tsx example/track.ts",
    "smoke:track-share": "dotenv -e .env -- tsx example/track-share.ts",
    "smoke:raw-track": "dotenv -e .env -- tsx example/raw-track.ts",
    "smoke:get-track": "dotenv -e .env -- tsx example/get-track.ts",
    "smoke:tracks": "dotenv -e .env -- tsx example/tracks.ts",
    "smoke:user-likes": "dotenv -e .env -- tsx example/user-likes.ts",
    "smoke:track-wrapped": "dotenv -e .env -- tsx example/track-wrapped.ts",
    "smoke:summary": "tsx smoke-runner.ts",
    "smoke:station-new": "dotenv -e .env -- tsx example/station-new.ts",
    "smoke:search": "dotenv -e .env -- tsx example/search.ts",
    "smoke:station-tracks": "dotenv -e .env -- tsx example/station-tracks.ts",
    "smoke:create-rotor-session": "dotenv -e .env -- tsx example/create-rotor-session.ts",
    "smoke:session-tracks": "dotenv -e .env -- tsx example/session-tracks.ts",
    "smoke:get-tracks-download": "dotenv -e .env -- tsx example/get-tracks-download.ts",
    "smoke:get-tracks-download-new": "dotenv -e .env -- tsx example/get-tracks-download-new.ts",
    "smoke:get-tracks-download-new-encript": "dotenv -e .env -- tsx example/get-tracks-download-new-encript.ts"
  }
}
